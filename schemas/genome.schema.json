{"$id":"https://justinahiggins614-cmyk.github.io/signature-backend/schemas/genome.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"description":"Output of SignatureBackend.buildGenome(). Deterministic: same genes+name+kind => same genome_id and stamp. Engine v2.0, schema v1.0.","properties":{"abilities":{"items":{"type":"string"},"type":"array"},"demoHTML":{"type":"string"},"demoKind":{"type":"string"},"demoTitle":{"type":"string"},"fallback":{"items":{"type":"string"},"type":"array"},"generator_version":{"type":"string"},"genome_id":{"description":"content-derived: the same gene choices always yield this ID","pattern":"^JAH-GENOME-[0-9A-Z]{6}$","type":"string"},"greeting":{"type":"string"},"id":{"pattern":"^opperater-[0-9a-z]+$","type":"string"},"kind":{"type":"string"},"mentality":{"type":"string"},"name":{"type":"string"},"params":{"type":"array"},"pitch":{"type":"number"},"py":{"type":"string"},"rate":{"type":"number"},"rules":{"type":"array"},"schema_version":{"type":"string"},"stamp":{"pattern":"^JAH-AI-OPR-[0-9A-Z]{4}$","type":"string"}},"required":["id","name","stamp","genome_id","generator_version","schema_version"],"title":"Opperater genome record","type":"object"}