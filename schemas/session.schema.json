{"$id":"https://justinahiggins614-cmyk.github.io/signature-backend/schemas/session.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Output of session.transcript() after dial(). A generated conversation record — labeled as such, never an official source document. Session memory dies at hangup and is never persisted by the engine. Engine v2.0, schema v1.0.","properties":{"ai_id":{"type":"string"},"ai_name":{"type":"string"},"api_version":{"type":"string"},"closed_at":{"format":"date-time","type":["string","null"]},"engine_version":{"type":"string"},"opened_at":{"format":"date-time","type":["string","null"]},"role_state":{"description":"UNLOCKED, or LOCKED_ROLE:<role>","type":"string"},"session_id":{"pattern":"^JAH-SESSION-\\d{6}$","type":"string"},"transcript_kind":{"const":"GENERATED_CONVERSATION","type":"string"},"turn_count":{"minimum":0,"type":"integer"},"turns":{"items":{"properties":{"at":{"format":"date-time","type":"string"},"input":{"type":"string"},"n":{"type":"integer"},"reply":{"type":"string"},"role":{"type":["string","null"]}},"required":["n","at","input","reply"],"type":"object"},"type":"array"}},"required":["transcript_kind","session_id","turn_count","turns","engine_version","api_version"],"title":"Session transcript","type":"object"}