{"$id":"https://justinahiggins614-cmyk.github.io/signature-backend/schemas/creation.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"description":"Output of SignatureBackend.animateCreation(). Deterministic: the same base + picks always animate this exact record. Engine v2.0, schema v1.0.","properties":{"abilities":{"items":{"type":"string"},"type":"array"},"baseName":{"type":"string"},"cls":{"description":"creature class, e.g. Bio-Mech Hybrid","type":"string"},"description":{"type":"string"},"name":{"type":"string"},"pickCount":{"minimum":0,"type":"integer"},"seed":{"type":"string"},"stamp":{"description":"permanent record stamp; same picks => same stamp","pattern":"^JAH-LAB-[0-9A-Z]{6}$","type":"string"},"stats":{"type":"object"},"svg":{"description":"deterministic creature illustration","type":"string"}},"required":["stamp","name","cls","description","abilities","seed","svg"],"title":"Mad Scientist Creation Lab creation record","type":"object"}